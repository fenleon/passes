<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ServerApplication"
        android:allowBackup="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="Passes Server"
        android:theme="@android:style/Theme.Black.NoTitleBar"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The tool scans QR codes itself (SDK LightQrCodeScanner) with the
             CAMERA permission declared in its lighttool.toml; the companion
             hosts the SDK service and the pass methods only. -->

        <!-- sdk:client merges its UnifiedPush service + file-share provider;
             the companion is a local app and uses neither. -->
        <service
            android:name="com.thelightphone.sdk.LightPushService"
            tools:node="remove" />
        <provider
            android:name="com.thelightphone.sdk.LightFileProvider"
            tools:node="remove" />
    </application>

</manifest>
